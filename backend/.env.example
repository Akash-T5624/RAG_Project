# Copy this file to .env and fill in your values

# Required: your Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq chat model
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Groq request timeout in seconds
GROQ_TIMEOUT_SECONDS=60
 
# Optional: maximum PDF upload size in MB
MAX_UPLOAD_MB=25

# Optional: number of chunks retrieved per question
RAG_TOP_K=5

# Optional: comma-separated list of allowed browser origins (dev mode)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
